# Copy this file to .env and fill in your values.

API_KEY=sk-your-api-key
BASE_URL=https://api.openai.com/v1

LLM_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Minimum cosine similarity (0–1) to pick a specialist. Short queries often
# score 0.2–0.4 against the canned examples; paraphrases score much higher.
ROUTER_SCORE_THRESHOLD=0.7

# LangGraph checkpointer. Matches the postgres service in docker-compose.yml.
POSTGRES_URI=postgresql://langgraph:langgraph@localhost:5432/langgraph?sslmode=disable

# Optional. If unset, MLflow is skipped. After `docker compose up -d`:
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT_NAME=langgraph-router
